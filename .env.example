# Qook env template — copy to .env.local (gitignored).
# Public values (shipped in client bundle) are prefixed EXPO_PUBLIC_.
# Supabase anon key is safe to ship — RLS is the security model.

# Public (client-safe)
EXPO_PUBLIC_SUPABASE_URL=https://<prod-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — do NOT set here. Use `supabase secrets set KEY=value`.
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_TEXT_MODEL=anthropic/claude-haiku-4.5
# OPENROUTER_POLISH_MODEL=anthropic/claude-sonnet-4.6
# OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-4.5
